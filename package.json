{
  "name": "heavy-rain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Heavy Rain multiagent orchestration workspace, bespoke UI libraries, and organization application prototypes.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:system": "npm run dev --workspace=@heavy-rain/system",
    "dev:augi": "npm run dev --workspace=@heavy-rain/augi-engineering",
    "check:boundaries": "node ./scripts/check-ui-boundaries.mjs",
    "build": "node ./scripts/check-ui-boundaries.mjs && npm run build --workspaces --if-present",
    "typecheck": "node ./scripts/check-ui-boundaries.mjs && npm run typecheck --workspaces --if-present",
    "test": "node ./scripts/check-ui-boundaries.mjs && npm run test --workspaces --if-present",
    "dev:rookmere": "npm run dev --workspace=@heavy-rain/rookmere-finance"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "vite": "^8.3.5",
    "@vitejs/plugin-react": "^6.1.2"
  }
}
